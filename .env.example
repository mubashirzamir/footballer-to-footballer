VITE_LANGUAGE=en

# ---------------------------
# API Base URL Configuration
# ---------------------------
# Local development (Python server running)
VITE_API_BASE_URL=http://localhost:8000
# Local development (using Vite proxy)
# VITE_API_BASE_URL=
# Production - Azure
# VITE_API_BASE_URL=
# Production - Render
# VITE_API_BASE_URL=

# ---------------------------
# API Implementation
# ---------------------------
# Use mock data
# VITE_API_IMPLEMENTATION=mock
# Use real Transfermarkt API
VITE_API_IMPLEMENTATION=transfermarkt

# ---------------------------
# Shortest Path Service
# ---------------------------
VITE_API_SHORTEST_PATH_IMPLEMENTATION=mock

# Local development
VITE_API_SHORTEST_PATH_BASE_URL=http://localhost:3000/api
# Production
# VITE_API_SHORTEST_PATH_BASE_URL=

# ---------------------------
# Image Sources
# ---------------------------
VITE_TEAM_IMAGE_SOURCE=

# ---------------------------
# LLM Gateway (for game generation script)
# ---------------------------
# LLMGATEWAY_API_KEY=
# LLM_MODEL=google-ai-studio/gemini-2.5-flash-lite

# ---------------------------
# Site URL (used for canonical links and OG tags)
